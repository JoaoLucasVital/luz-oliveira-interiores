---
import "../styles/not-found.css";
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="O endereço acessado não foi encontrado no site da Luz Oliveira Interiores." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f8eee9" />
    <link rel="icon" href="/favicon-logo.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Página não encontrada | Luz Oliveira Interiores</title>
  </head>
  <body data-page="not-found">
    <a class="not-found-brand" href="/" aria-label="Luz Oliveira Interiores — voltar ao início">
      <span class="not-found-logo" aria-hidden="true"></span>
    </a>

    <main class="not-found-shell">
      <div class="not-found-glow glow-one" aria-hidden="true"></div>
      <div class="not-found-glow glow-two" aria-hidden="true"></div>
      <div class="not-found-plan" aria-hidden="true">
        <span class="plan-line plan-horizontal"></span>
        <span class="plan-line plan-vertical"></span>
        <span class="plan-arc"></span>
      </div>

      <section class="not-found-content" aria-labelledby="not-found-title">
        <p class="not-found-eyebrow">Endereço não encontrado</p>
        <p class="not-found-code" aria-hidden="true">404</p>
        <h1 id="not-found-title">Este ambiente <em>ainda não existe.</em></h1>
        <p class="not-found-copy">O endereço pode ter mudado, ter sido removido ou apenas ter sido digitado de outro jeito.</p>
        <div class="not-found-actions" aria-label="Opções para continuar navegando">
          <a class="not-found-primary" href="/">Voltar ao início</a>
          <a class="not-found-secondary" href="/#projetos">Conhecer projetos</a>
        </div>
      </section>

      <p class="not-found-signature">Luz Oliveira Interiores <span aria-hidden="true">·</span> Maceió, AL</p>
    </main>
  </body>
</html>
